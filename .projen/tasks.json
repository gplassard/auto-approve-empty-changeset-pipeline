{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(pnpm -c exec \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "build:ci": {
      "name": "build:ci",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test:ci"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "cdk:app": {
      "name": "cdk:app",
      "steps": [
        {
          "exec": "pnpm cdk --app 'ts-node src/bin/app.ts'"
        }
      ]
    },
    "cdk:pipeline": {
      "name": "cdk:pipeline",
      "steps": [
        {
          "exec": "pnpm cdk --app 'ts-node src/bin/pipeline.ts'"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "exec": "git checkout -b scratch",
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout $BRANCH"
        },
        {
          "exec": "git fetch origin",
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard origin/$BRANCH",
          "name": "hard reset to origin commit"
        },
        {
          "exec": "git clean -fdx",
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build"
          ]
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--noEmit",
            "-p",
            "projenrc/tsconfig.json"
          ],
          "name": "typecheck"
        },
        {
          "execArgs": [
            "tsx",
            "--tsconfig",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "exec": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern $@ . src/bin src/cdk projenrc .projenrc.ts",
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "pnpm i --no-frozen-lockfile"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "pnpm i --frozen-lockfile"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "pnpm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "vitest run -u",
          "receiveArgs": true
        }
      ]
    },
    "test:ci": {
      "name": "test:ci",
      "env": {
        "NODE_OPTIONS": "--import /home/runner/work/auto-approve-empty-changeset-pipeline/auto-approve-empty-changeset-pipeline/.datadog/lib/node_modules/dd-trace/register.js -r /home/runner/work/auto-approve-empty-changeset-pipeline/auto-approve-empty-changeset-pipeline/.datadog/lib/node_modules/dd-trace/ci/init"
      },
      "steps": [
        {
          "exec": "vitest run -u",
          "receiveArgs": true
        }
      ]
    },
    "test:compile": {
      "name": "test:compile",
      "steps": [
        {
          "exec": "tsc --noEmit --project projenrc/tsconfig.json"
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run vitest in watch mode",
      "steps": [
        {
          "exec": "vitest watch"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "pnpm",
            "dlx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=latest",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@gplassard/projen-extensions,@stylistic/eslint-plugin,@types/aws-lambda,@types/node,aws-cdk,aws-cdk-lib,esbuild,eslint,eslint-import-resolver-typescript,eslint-plugin-import,eslint-plugin-unused-imports,projen,tsx,vitest,@aws-lambda-powertools/logger,@aws-sdk/client-cloudformation,@aws-sdk/client-codepipeline"
          ]
        },
        {
          "exec": "pnpm i --no-frozen-lockfile"
        },
        {
          "execArgs": [
            "pnpm",
            "update",
            "@gplassard/projen-extensions",
            "@stylistic/eslint-plugin",
            "@types/aws-lambda",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "aws-cdk",
            "aws-cdk-lib",
            "constructs",
            "esbuild",
            "eslint",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint-plugin-unused-imports",
            "projen",
            "tsx",
            "typescript",
            "vitest",
            "@aws-lambda-powertools/logger",
            "@aws-sdk/client-cloudformation",
            "@aws-sdk/client-codepipeline"
          ]
        },
        {
          "exec": "pnpm exec projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build",
            "-w"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
